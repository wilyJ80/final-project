@article{rogerio,
  title = {Um ambiente aberto baseado em microcontrolador para experimentos
           didáticos de física: conversão fotovoltaica},
  volume = {12},
  url = {
         https://ojs.brazilianjournals.com.br/ojs/index.php/BRJD/article/view/88165
         },
  DOI = {10.34117/bjdv12n7-012},
  abstractNote = {&amp;lt;p&amp;gt;A recente disseminação dos microcontroladores
                  e transdutores de baixo custo viabiliza toda uma gama de
                  dispositivos e procedimentos para automatizar experimentos
                  didáticos de física. Decorre daí a possibilidade de engajar
                  professores e estudantes em ambientes didaticamente
                  estimulantes e significativos, por meio de aparatos
                  experimentais amplamente configuráveis. O presente texto
                  apresenta um ambiente aberto e modular, de baixo custo, para
                  automação de experimentos de física, usando a placa de
                  desenvolvimento Arduino UNO e o computador Raspberry Pi. Como
                  prova de conceito, foi realizado um experimento em que uma
                  célula fotovoltaica carrega um capacitor, sob diferentes
                  condições de iluminação. A funcionalidade do aparato
                  experimental permitiu realizar, em apenas uma tarde, 96 rodadas
                  de aquisição de dados, com variação de parâmetros e mensurações
                  sucessivas em intervalos de 1s, o que seria impossível
                  manualmente. Além disso, os dados obtidos capturaram situações
                  anômalas, a requerer análise e interpretação, o que é muito
                  positivo, didaticamente. A possibilidade de alterar livremente
                  o hardware e o software do aparato experimental permite
                  constatar como as escolhas metodológicas impactam os resultados
                  dos experimentos.&amp;lt;/p&amp;gt;},
  number = {7},
  journal = {Brazilian Journal of Development},
  author = {Amorim, Cláudio Alves de and Conceição, Rogério do Carmo},
  year = {2026},
  month = {Jul.},
  pages = {e88165},
}
